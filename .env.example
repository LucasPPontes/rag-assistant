# ============================================
# CONFIGURAÇÕES DO ASSISTENTE RAG
# ============================================

# --- MinIO (Object Storage S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=rag-bucket
MINIO_SECURE=False

# --- ChromaDB (Banco de Dados Vetorial) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=pdf_documents

# --- Modelo de Embeddings (Multilíngue CPU) ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Provedor de LLM (Google Gemini / OpenAI) ---
# Obtenha sua chave gratuita do Gemini no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Opcional)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Streamlit Frontend ---
BACKEND_URL=http://backend:8001
